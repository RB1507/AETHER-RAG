# App
APP_NAME=AETHER RAG
APP_ENV=development
APP_PORT=8000
SECRET_KEY=your-secret-key-minimum-32-chars-change-this-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://raguser:ragpass@localhost:5432/ragdb

# Redis
REDIS_URL=redis://localhost:6379/0

# Vector Store (LanceDB)
LANCE_URI=./vector_store
LANCE_TABLE_NAME=aether_rag

# Embedding
EMBEDDING_MODEL=BAAI/bge-small-en
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384

# LLM
# Provider: "ollama" (local) or "openrouter" (hosted free models)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.5:4b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=256

# OpenRouter (get a free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_LENGTH=50

# Retrieval
TOP_K=3
HYBRID_ALPHA=0.5
USE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# File Upload
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,txt,docx
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
