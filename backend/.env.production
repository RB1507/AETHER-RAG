# Production config bundled into the AETHER RAG installer, placed next to the
# frozen backend exe (resources/backend/.env). The frozen config.py reads this.
#
# NOTE: writable paths (DATABASE_URL, CHROMA_PERSIST_DIR, EMBEDDING_CACHE_DIR,
# UPLOAD_DIR, LOG_DIR) and SECRET_KEY are injected at launch by the Electron
# main process pointing at the user's writable userData folder, and ENV VARS
# TAKE PRECEDENCE over this file — so the values here are only fallbacks.
#
# The OpenRouter key below is the bundled default; a user can override it (and
# the model) by creating a settings.env in the app's userData folder.

# App
APP_NAME=AETHER RAG
APP_ENV=production
APP_PORT=8000
SECRET_KEY=change-me-injected-at-runtime
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database / Redis (paths injected at runtime; Redis falls back to local memory)
DATABASE_URL=sqlite:///./sql_app.db
REDIS_URL=redis://localhost:6379/0

# Vector Store (LanceDB)
LANCE_URI=./vector_store
LANCE_TABLE_NAME=aether_rag

# Embedding (ONNX via fastembed) — model downloaded on first run
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=./model_cache

# LLM — hosted providers (Mistral / OpenRouter). User switches provider+model
# at runtime from the chat header.
LLM_PROVIDER=mistral
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
# SECURITY: no API keys are bundled in the installer. The user supplies their own
# key(s) via the in-app settings (written to <userData>/settings.env, which the
# Electron launcher injects and which overrides this file).
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=openai/gpt-oss-20b:free,google/gemma-4-26b-a4b-it:free,openrouter/free

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_LENGTH=50

# Retrieval
TOP_K=3
HYBRID_ALPHA=0.5
USE_RERANKER=false

# File Upload
MAX_FILE_SIZE_MB=20
ALLOWED_EXTENSIONS=pdf,txt,docx
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs
